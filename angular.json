{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "edumig-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/edumig-angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [
              "src/assets/webflow/js/jquery-3.5.1.min.js",
              "src/assets/webflow/js/webflow.js"
            ],
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "3mb", "maximumError": "4mb" },
                { "type": "anyComponentStyle", "maximumWarning": "2mb", "maximumError": "3mb" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "defaultConfiguration": "development",
          "options": {
            "buildTarget": "edumig-angular:build",
            "host": "0.0.0.0",
            "port": 4200
          },
          "configurations": {
            "development": {
              "buildTarget": "edumig-angular:build:development"
            },
            "production": {
              "buildTarget": "edumig-angular:build:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "a6cd8771-2dd1-4904-820a-9e9292d2cadc"
  }
}